{
  "id": "./",
  "name": "MLBB Vault — Skin Tracker",
  "short_name": "MLBB Vault",
  "description": "Tracker de ahorro para skins Legend, Aspirantes y colaboraciones de MLBB.",
  "lang": "es",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0b0b14",
